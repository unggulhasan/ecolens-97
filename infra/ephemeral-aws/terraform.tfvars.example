# Copy this file to terraform.tfvars (which is gitignored) before applying.
# Only override these if your project name or region differs from the defaults.

app_name    = "aussie-ecolens"
environment = "prod"

aws_region = "ap-southeast-4"

# AUTH_SECRET for NextAuth — generate with: openssl rand -hex 32
auth_secret = "generate with: openssl rand -hex 32"

# Output of: cd infra/ephemeral-gcp && terraform output gcp_function_url
gcp_function_url = "get from: cd ../ephemeral-gcp && terraform output gcp_function_url"
