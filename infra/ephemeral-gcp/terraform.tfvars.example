# Copy this file to terraform.tfvars (which is gitignored) before applying.
# Only override these if your project name or region differs from the defaults.

app_name    = "aussie-ecolens"
environment = "prod"

gcp_project_id = "ecolens-498408"
gcp_region     = "australia-southeast2"

# Injected automatically by deploy.sh via TF_VAR_aws_results_url.
# To set manually: cd ../ephemeral-aws && terraform output -raw inference_results_url
aws_results_url = []
